<resources>
    <!-- Android 15+: keep the classic (non edge-to-edge) layout so the top bar and the
         bottom navigation never sit under the status bar / gesture bar. -->
    <style name="Theme.QCMSApp" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/qcms_teal</item>
        <item name="android:colorPrimaryDark">@color/qcms_teal_dark</item>
        <item name="android:colorAccent">@color/qcms_teal</item>
        <item name="android:statusBarColor">@color/qcms_teal_dark</item>
        <item name="android:navigationBarColor">@color/qcms_white</item>
        <item name="android:windowBackground">@color/qcms_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>

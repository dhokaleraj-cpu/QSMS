# Local credentials and environments
.streamlit/secrets.toml
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Local exports and runtime files
exports/
logs/
*.log
updates/processed/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Android local build artifacts (source and CI workflow stay tracked)
mobile/android_qcms/.gradle/
mobile/android_qcms/local.properties
mobile/android_qcms/build/
mobile/android_qcms/app/build/
*.jks
*.keystore
*.apk
*.aab
apk-artifacts/

# QCMS native Android app (R29): build output ignored; the fixed TEST signing key is tracked
# so every CI-built APK installs over the previous one.
mobile/android_qcms_app/.gradle/
mobile/android_qcms_app/local.properties
mobile/android_qcms_app/build/
mobile/android_qcms_app/app/build/
!mobile/android_qcms_app/app/qcms-debug.keystore

# STAWN QCMS iOS / iPadOS app (R34): build output ignored
mobile/ios_stawn_qcms/build/
mobile/ios_stawn_qcms/build.log
mobile/ios_stawn_qcms/STAWNQCMS.xcodeproj/xcuserdata/
mobile/ios_stawn_qcms/STAWNQCMS.xcodeproj/project.xcworkspace/xcuserdata/
